rules_version = '2';

// 업무 데이터는 클라이언트에서 직접 읽고 쓰지 않는다. 모든 접근은 서버(Firebase Admin)가 소유권을 확인한 뒤 처리한다. (docs/05)
// 2026-10-02 kakaobot-6fea2 프로젝트의 배포된 규칙과 동일함을 확인.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
