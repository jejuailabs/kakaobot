{
  "name": "katcha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "assets:backgrounds": "node scripts/generate-backgrounds.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:firebase": "node --dns-result-order=ipv4first scripts/firebase-check.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "admin:grant": "node --dns-result-order=ipv4first scripts/grant-role.mjs",
    "gateway:mock": "node gateway/mock-gateway.ts",
    "e2e:connection": "node --dns-result-order=ipv4first scripts/e2e-connection.mjs",
    "e2e:admin": "node --dns-result-order=ipv4first scripts/e2e-admin.mjs",
    "verify": "eslint . && tsc --noEmit && vitest run && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "pretendard": "1.3.9",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "15.32.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "overrides": {
    "firebase-admin": {
      "jwks-rsa": "3.2.2"
    }
  }
}
